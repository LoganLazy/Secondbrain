{
  "name": "nebula-memory-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.loganlazy.nebulamemory",
    "productName": "Nebula Memory",
    "directories": {
      "output": "out"
    },
    "files": ["main.js", "package.json"],
    "win": {
      "target": ["dir"]
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
