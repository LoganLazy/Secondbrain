# 复制为 .env 并填入密钥

# ---- 对话模型(OpenAI兼容, 必填) ----
DEEPSEEK_KEY=sk-xxx
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
# 中转站示例: CHAT_BASE_URL=https://ai.xxxx.xyz/v1  CHAT_MODEL=xxx

# ---- 向量化(决定语义搜索质量) ----
# 三选一, 改EMBED_BASE_URL/EMBED_MODEL即可切换:
#   智谱:     https://open.bigmodel.cn/api/paas/v4   embedding-3
#   硅基流动: https://api.siliconflow.cn/v1          BAAI/bge-m3 (免费)
#   本地:     http://127.0.0.1:11434/v1              bge-m3 (ollama)
EMBED_PROVIDER=zhipu
ZHIPU_KEY=xxx
EMBED_MODEL=embedding-3

# 不配任何Key时自动用离线mock向量(仅能联调, 搜索质量差)
